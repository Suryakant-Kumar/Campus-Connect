# ==============================================================================
# CampusConnect Environment Variables Reference
# ==============================================================================

# 1. DATABASE CONFIGURATION (PostgreSQL)
# Connection string for Neon, Supabase, Cloud SQL, or any PostgreSQL provider.
# Example: postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# Note: If left empty, CampusConnect runs on an in-memory fallback store for local development.
DATABASE_URL="postgresql://username:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. SESSION & TOKEN SECURITY
# 32+ character random secret used for signing and verifying HMAC-SHA256 user authentication tokens.
SESSION_SECRET="change-this-to-a-very-secure-random-32-char-string-in-production"

# 3. GOOGLE GEMINI AI API (Server-Side Triage)
# API key for Google Gemini model inference (@google/genai SDK).
# Used for clarity scoring (1-10), safety check, hazard urgency ranking, and worker summaries.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Model identifier for Gemini API calls. Default: gemini-2.5-flash or gemini-2.5-pro
GEMINI_MODEL="gemini-2.5-flash"

# 4. APP & DOMAIN URL
# The public canonical URL where the app is hosted (e.g. https://campusconnect.com).
# In local development, defaults to http://localhost:3000.
APP_URL="http://localhost:3000"

# 5. ONLINE CLOUD STORAGE (Vercel Blob / Supabase)
# For storing incident photo attachments in a stateless cloud environment.
# Zero files are ever written to the local disk.
# Obtain from Vercel Project Settings -> Storage -> Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_sample"

# 6. GLOBAL FOUNDER SETUP KEY (Optional)
# Secret key to authenticate global platform founder / super-admin accounts on initial setup.
FOUNDER_REGISTRATION_KEY="change-this-founder-secret-key"

# 7. PORT (Default: 3000)
PORT=3000
